{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "protected/**": "deny"
    },
    "edit": {
      "*": "ask",
      "protected/**": "deny",
      "data/**": "deny",
      "configs/**": "ask",
      "output/**": "allow"
    },
    "bash": {
      "*": "ask",
      "python3 scripts/guarded_query.py *": "allow",
      "python3 scripts/request_config_change.py *": "allow",
      "python3 scripts/validate_guardrails.py": "allow",
      "python3 -c *": "deny",
      "sqlite3 *": "deny",
      "psql *": "deny",
      "mysql *": "deny",
      "rm *": "deny"
    },
    "skill": {
      "permission-guarded-ops": "allow",
      "production-*": "deny"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
