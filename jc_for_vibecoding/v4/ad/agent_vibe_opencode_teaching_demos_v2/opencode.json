{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/*.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "skill": {
      "teaching-*": "allow",
      "doc-*": "allow",
      "rich-*": "allow",
      "permission-*": "allow",
      "production-*": "deny",
      "experimental-*": "ask",
      "*": "ask"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
