APP_NAME=Flash-Agents
ENV=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=mysql+pymysql://flash:flash@127.0.0.1:3306/flash_agents?charset=utf8mb4
DB_POOL_SIZE=80
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600

JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRE_MINUTES=720

SSO_ENABLED=false
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=flash-agents
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:5173/auth/callback
AUTH_ALLOW_UNLISTED=true
WHITELIST_PATH=./backend/whitelist.json

ALLOWED_DOMAINS=RD,MEC,IT
DEFAULT_DOMAIN=IT
WORKSPACE_ROOT=./workspaces
SKILL_ROOT=./skills_store
AGENT_ROOT=./backend/agents
LOG_DIR=./logs

OPENCODE_BINARY=opencode
OPENCODE_API_PREFIX=/api
OPENCODE_BASE_PORT=20000
OPENCODE_DEFAULT_PORT=4096
OPENCODE_MOCK_ON_FAILURE=true
OPENCODE_REQUEST_TIMEOUT_SECONDS=3600

SYSTEMD_ENABLED=false
SYSTEMD_USER_DIR=~/.config/systemd/user
SYSTEMD_ENV_DIR=~/.config/flash-agents/opencode
INSTANCE_MEMORY_MAX=32G
INSTANCE_CPU_QUOTA=200%
BWRAP_PATH=bwrap
IDLE_TIMEOUT_SECONDS=1200
IDLE_SCAN_SECONDS=30
HEARTBEAT_SECONDS=15
