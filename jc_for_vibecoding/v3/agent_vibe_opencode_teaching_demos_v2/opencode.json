{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "skill": {
      "rule-based-doc-generator": "allow",
      "spec-portability-builder": "allow",
      "rich-text-extraction-pipeline": "allow",
      "manual-rule-extractor": "allow",
      "environment-sequence-adapter": "allow",
      "syntax-validation-gate": "allow",
      "permission-constrained-analysis": "allow",
      "unsafe-*": "deny"
    },
    "external_directory": "deny"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "build": {
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    }
  }
}