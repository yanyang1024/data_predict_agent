{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": {
      "*": "ask",
      "docs/**": "deny",
      "references/**": "deny",
      "tests/golden_cases.json": "deny",
      "generated/**": "allow",
      "output/**": "allow"
    },
    "bash": {
      "*": "ask",
      "python3 scripts/port_py_to_js.py*": "allow",
      "python3 scripts/validate_port.py*": "allow",
      "node tests/run_golden_cases.mjs*": "allow",
      "python3 run_demo.py": "allow",
      "rm *": "deny"
    },
    "skill": {
      "spec-porting": "allow",
      "*": "ask"
    },
    "external_directory": "deny"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
