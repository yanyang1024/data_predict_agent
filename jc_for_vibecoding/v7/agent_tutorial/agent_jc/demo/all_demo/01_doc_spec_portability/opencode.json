{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": {
      "*": "ask",
      "docs/**": "deny",
      "references/**": "deny",
      "tests/analysis_cases.json": "deny",
      "tests/*.csv": "deny",
      "generated/**": "allow",
      "output/**": "allow"
    },
    "bash": {
      "*": "ask",
      "python3 scripts/port_gradio_to_flask.py*": "allow",
      "python3 scripts/validate_flask_port.py*": "allow",
      "python3 ../scripts/demo_viewer.py*": "allow",
      "python3 run_demo.py": "allow",
      "rm *": "deny"
    },
    "skill": {
      "spec-porting": "allow",
      "*": "ask"
    },
    "external_directory": "deny"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
