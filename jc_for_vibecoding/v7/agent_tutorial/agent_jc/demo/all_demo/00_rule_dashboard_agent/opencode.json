{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": {
      "*": "ask",
      "templates/**": "deny",
      "references/**": "deny",
      "output/**": "allow"
    },
    "bash": {
      "*": "ask",
      "python3 scripts/generate_dashboard.py*": "allow",
      "python3 scripts/validate_dashboard.py*": "allow",
      "python3 run_demo.py": "allow",
      "rm *": "deny"
    },
    "skill": {
      "dashboard-generator": "allow",
      "*": "ask"
    },
    "external_directory": "deny"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
