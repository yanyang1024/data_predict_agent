{
  "$schema": "https://opencode.ai/config.json",

  // Project default model. This overrides global model for this repo.
  "model": "openrouter/moonshotai/kimi-k2",

  // Explicitly include project rules beyond AGENTS.md.
  "instructions": [
    "docs/development-standards.md",
    "docs/testing-policy.md"
  ],

  // Use with caution. Keep true unless the repo is huge and Git checkpoint is mandatory.
  "snapshot": true,

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "coverage/**",
      ".next/**",
      ".turbo/**",
      "target/**",
      "logs/**"
    ]
  },

  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    },
    "build": {
      "mode": "primary",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "pnpm test*": "ask",
          "pnpm typecheck*": "ask",
          "pnpm lint*": "ask",
          "git push*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf*": "deny",
          "pkill *": "deny",
          "killall *": "deny"
        }
      }
    },
    "review": {
      "description": "Review code for correctness, security, edge cases and tests. Never modify files.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git status*": "allow",
          "rg *": "allow"
        }
      }
    }
  },

  "command": {
    "review-diff": {
      "template": "Review current git diff. Do not edit files. Focus on correctness, edge cases, security, tests, and unrelated changes.\n\nDiff stat:\n!`git diff --stat`\n\nDiff:\n!`git diff`",
      "description": "Review current git diff",
      "agent": "plan"
    }
  },

  "permission": {
    "external_directory": "ask",
    "doom_loop": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": {
      "*": "ask",
      "project-*": "allow",
      "experimental-*": "deny"
    }
  }
}
