# ASR 模型配置 (本地路径)
MODEL_PATH=/models/Qwen3-ASR-1.7B

# LLM API 配置 (用于翻译，OpenAI 兼容格式)
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen2.5-7B-Instruct

# ASR 处理参数
ASR_LANGUAGE=Chinese
ASR_CHUNK_SEC=2.0
ASR_STEP_SEC=1.0

# 翻译参数
TRANSLATE_MAX_HISTORY=10

# 音频参数
SAMPLE_RATE=16000

# Flask 服务配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
